# Modèle de configuration — copie ce fichier en « .env » pour les essais en local.
# En production chez alwaysdata, ces valeurs se saisissent dans l'interface d'admin
# (Sites → ton site Node.js → Environnement). Le fichier .env n'est JAMAIS versionné.

# --- Base de données -------------------------------------------------------
# alwaysdata donne l'hôte, l'utilisateur et le nom de la base dans Bases de données.
PGHOST=postgresql-TONCOMPTE.alwaysdata.net
PGPORT=5432
PGUSER=TONCOMPTE
PGPASSWORD=
PGDATABASE=TONCOMPTE_atelier
# En variante, une seule ligne :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# PGSSL=1   (seulement si l'hébergeur impose TLS ; inutile chez alwaysdata)

# --- Sécurité --------------------------------------------------------------
# Secret d'application mêlé aux mots de passe avant hachage. À générer une fois :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠ Le changer rend TOUS les mots de passe existants invalides. Sauvegarde-le
#   ailleurs que sur le serveur (gestionnaire de mots de passe).
POIVRE=

# --- Réseau ----------------------------------------------------------------
# Domaines autorisés à appeler l'API depuis un navigateur, séparés par des virgules.
# Mets ici l'adresse exacte où sont publiés les jeux (protocole compris, sans / final).
ORIGINES=https://gregoirelecossois.github.io

# --- Conservation des données -----------------------------------------------
# Durée de vie MAXIMALE d'un compte élève, en mois, comptée depuis sa CRÉATION. Passé ce
# délai le serveur le supprime tout seul (progression et trophées compris) et l'inscrit
# au journal. En temps normal le compte part avant, à la fin de la 3e ou du CAP, par la
# « Nouvelle année » du tableau de bord : ceci n'est que le filet. Valeur par défaut : 60.
CONSERVATION_MOIS=60

# Durée de conservation du journal des connexions et des actions enseignantes, en mois.
# Il contient identifiants et adresses IP. Douze mois est la durée usuelle pour des
# traces de connexion. Purgé automatiquement, indépendamment des comptes.
JOURNAL_MOIS=12

# --- Travail à la maison, sans compte (README § 4 bis) -------------------------
# Durée de vie d'une ligne (prénom, classe, étapes, score), en mois, comptée depuis la
# DERNIÈRE activité. Valeur par défaut : 12.
# DEVOIRS_MOIS=12
# Nombre maximal de lignes par établissement. Valeur par défaut : 3000.
# DEVOIRS_MAX=3000

# --- Projets MakeCode (makecode.html) -----------------------------------------
# Nombre maximal de projets en ligne par élève. Valeur par défaut : 30.
# MC_PROJETS_MAX=30
# Place maximale occupée par TOUS les projets et les modèles, en Mo. Au-delà, les nouveaux
# envois sont refusés (les projets restent sur les postes) : le disque n'est jamais rempli
# au point d'empêcher les ateliers d'enregistrer la progression. Valeur par défaut : 40.
# MC_TABLE_MAX_MO=40
# Nombre maximal de modèles qu'un établissement peut proposer à ses classes (projets
# préparés par les enseignants, cf. README § 2.8). Valeur par défaut : 60.
# MC_MODELES_MAX=60

# Port d'écoute. alwaysdata le fournit automatiquement : ne le renseigne qu'en local.
# PORT=8300
